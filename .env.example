# Service Mode: all (default), http, grpc, worker
SERVICE_MODE=all
PORT=8080
GRPC_PORT=9090
# RUN_SCHEDULERS=true # Optional when SERVICE_MODE=http

# Redis (node status reports queue)
REDIS_ADDR=localhost:6379
# Dirección pública del servidor gRPC que los agentes usarán para conectarse.
# En producción: nombre de host estable (ej: grpc.tudominio.com:9090)
GRPC_ADDRESS=
DATABASE_URL=postgres://autohost:autohost@localhost:5432/autohost?sslmode=disable
JWT_SECRET=supersecret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=24h   # 24h
FRONTEND_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=enter_your_google_client_id_here

# R2 Cloud Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_key
R2_SECRET_ACCESS_KEY=your_secret
R2_BUCKET_NAME=your_bucket

# Headscale VPN
HEADSCALE_URL=https://example.com
HEADSCALE_API_KEY=example_api_key

# Google AI / Vertex AI
# Option 1: Vertex AI 
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1

# Option 2: Google AI Studio API Key (if not using GCP Vertex AI)
GEMINI_API_KEY=example_api_key
GEMINI_MODEL=gemini_example_model