# ==============================================================================
# AutoHost Self-Hosted Environment Variables (.env)
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=autohost
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=autohost

# AutoHost API Security
JWT_SECRET=generate_a_random_32_characters_secret_key_here
# Encrypts credentials stored in the database (connectors). 32 bytes as hex: openssl rand -hex 32
# Keep it: changing or losing it makes stored credentials unreadable. Empty = connectors cannot store them.
SECRETS_ENCRYPTION_KEY=
# Let connectors call private addresses (LAN, VPN) from the API. Loopback and cloud metadata stay blocked.
CONNECTORS_ALLOW_PRIVATE_NETWORKS=false

# Topology & Self-Hosted Registration
ALLOW_REGISTRATION=false
AUTO_ENROLL_LOCAL_NODE=true

# Storage (path on host for DB data, local node certs, and container volumes)
AUTOHOST_STORAGE_DIR=/var/lib/autohost
AUTOHOST_LOCAL_AGENT_DIR=/etc/autohost

# Ports
API_PORT=8080
GRPC_PORT=9090
WEB_PORT=3000

# Public or LAN URLs (IMPORTANTE: si accedes desde tu PC a la Pi, pon la IP de la Pi ej: http://192.168.1.50:8080 o tu dominio)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: URL remote agents use to reach this API (e.g. https://api.example.com). When empty, it is
# derived from the local node's VPN/LAN IP and API_PORT.
API_PUBLIC_URL=

# Optional: Google OAuth (leave empty to use email/password only)
GOOGLE_CLIENT_ID=

# API reference: serves the OpenAPI spec at /openapi.yaml and an interactive reference at /docs
API_DOCS_ENABLED=false

# MCP endpoint (/mcp) for AI assistants, authenticated with a personal API token. Set false to disable.
MCP_ENABLED=true

# Built-in assistant (chat in the panel). Admins configure it in the panel; these are used until then.
# Any OpenAI-compatible API, e.g. Ollama: ASSISTANT_BASE_URL=http://localhost:11434/v1 ASSISTANT_MODEL=qwen3:8b
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
