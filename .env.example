# ==============================================================================
# AutoHost Self-Hosted Environment Variables (.env)
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=autohost
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=autohost

# AutoHost API Security
JWT_SECRET=generate_a_random_32_characters_secret_key_here

# Topology & Self-Hosted Registration
ALLOW_REGISTRATION=false
AUTO_ENROLL_LOCAL_NODE=true

# Storage (path on host for DB data, local node certs, and container volumes)
AUTOHOST_STORAGE_DIR=/var/lib/autohost
AUTOHOST_LOCAL_AGENT_DIR=/etc/autohost

# Ports
API_PORT=8080
GRPC_PORT=9090
WEB_PORT=3000

# Public or LAN URLs (IMPORTANTE: si accedes desde tu PC a la Pi, pon la IP de la Pi ej: http://192.168.1.50:8080 o tu dominio)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: Google OAuth (leave empty to use email/password only)
GOOGLE_CLIENT_ID=
